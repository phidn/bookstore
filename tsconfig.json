{
  "extends": [
    "astro/tsconfigs/strict",
    "./tsconfig.theme.json"
  ],
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist",
    "mcp"
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "#theme/*": ["./src/themes/default/*"]
    },
    "types": [
      "@cloudflare/workers-types"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  }
}