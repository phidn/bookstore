---
import { getConfig } from '../config';
import { paymentsInDemoMode } from '../features/payments';
import { localCommerce } from '../local-commerce';
import { shippingFor } from '../features/shipping/effective';
import { env } from 'cloudflare:workers';
import { countUnresolvedInventoryExceptions } from '../features/orders/db';
import { AdminShell } from '@/components/admin/AdminShell';
import type { SectionKey } from '@/components/admin/AppSidebar';
// Admin's OWN stylesheet — never global.css, which carries the active
// storefront set's tokens and base-layer rules. A dark set would otherwise
// restyle every authenticated Admin page (see src/styles/admin.css).
import '../styles/admin.css';

interface Props {
  title?: string;
  active?: SectionKey;
}

const { title, active } = Astro.props;
const config = getConfig();
const storeName = Astro.locals.settings?.storeName ?? config.storeName;
// Nudge to finish first-run setup — except while on the wizard itself.
const showSetupNudge =
  !Astro.locals.settings?.setupComplete && Astro.url.pathname !== '/admin/setup';
// Show "Log out" only when a password-login session cookie is present. Under
// Cloudflare Access or local dev there's no minshop session to clear.
const showLogout = !!Astro.cookies.get('admin_session')?.value;
const pageTitle = title ? `${title} — ${storeName} admin` : `${storeName} admin`;
// Configuration that fails closed blocks checkout for physical orders, and the only
// other signal is a Worker log nobody is watching. Surface it on EVERY admin page,
// not just the shipping one — the merchant should not have to go looking to find
// out that they cannot take orders. Resolution is already loaded for this request,
// so this costs no query.
const shippingIssue = localCommerce.enabled ? null : shippingFor(Astro.locals.settings).issue;
const inventoryExceptionCount = await countUnresolvedInventoryExceptions(env.DB);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
  </head>
  <body class="min-h-screen bg-paper text-ink antialiased">
    <AdminShell
      client:load
      active={active}
      storeName={storeName}
      showLogout={showLogout}
      showShipping={!localCommerce.enabled}
    >
      {
        showSetupNudge && (
          <a
            href="/admin/setup"
            class="mb-6 flex items-center justify-between gap-3 rounded-md border border-brand/30 bg-brand/5 px-4 py-3 text-sm text-gray-700 transition hover:border-brand"
          >
            <span>
              <strong class="font-semibold">Finish setting up your store</strong> — store name,
              payment status, and more.
            </span>
            <span aria-hidden="true" class="text-brand">&rarr;</span>
          </a>
        )
      }
      {
        !localCommerce.enabled && Astro.locals.settings && paymentsInDemoMode(Astro.locals.settings) && (
          <div class="mb-6 rounded-md border border-amber-300 bg-amber-50 px-4 py-3 text-sm text-amber-800">
            <strong class="font-semibold">No real payment method configured.</strong> Only{' '}
            <strong>Demo checkout</strong> can take orders right now — they're recorded and tagged{' '}
            <code class="rounded bg-amber-100 px-1 text-xs">demo</code>. Shoppers see setup links
            for Card &amp; Lightning until you add a key. Demo stays available alongside real rails.
          </div>
        )
      }
      {
        shippingIssue && (
          <a
            href="/admin/shipping"
            class="mb-6 flex items-center justify-between gap-3 rounded-md border border-red-300 bg-red-50 px-4 py-3 text-sm text-red-800 transition hover:border-red-500"
          >
            <span>
              <strong class="font-semibold">Shipping checkout is blocked by invalid configuration:</strong>{' '}
              {shippingIssue.reason}
            </span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        )
      }
      {
        inventoryExceptionCount > 0 && (
          <a
            href="/admin/orders#inventory-exceptions"
            class="mb-6 flex items-center justify-between gap-3 rounded-md border border-red-300 bg-red-50 px-4 py-3 text-sm text-red-800 transition hover:border-red-500"
          >
            <span>
              <strong class="font-semibold">Inventory needs attention.</strong>{' '}
              {inventoryExceptionCount} paid order line{inventoryExceptionCount === 1 ? '' : 's'} arrived after its stock hold ended and could not be fully deducted. Open the affected orders and reconcile stock.
            </span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        )
      }
      <slot />
    </AdminShell>
  </body>
</html>
