---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { formatPrice, formatDate, getConfig } from '../../../config';
import {
  listOrders,
  getOrder,
  getOrderByPublicId,
  findOrderPublicIdByReference,
  listUnresolvedInventoryExceptions,
} from '../../../features/orders/db';
import { orderReference } from '../../../features/orders/number';
import { listUnmatchedRefundEvents } from '../../../features/refunds/db';
import {
  parseOrderOrLegacyPublicId,
  parsePublicId,
  PUBLIC_ID_TOKEN_LENGTH,
} from '../../../features/ids/publicId';
import AdminOrderTable, { type OrderItem } from '../../../components/AdminOrderTable.astro';

// Order lookup: direct query support for quick jumping
const rawQuery = Astro.url.searchParams.get('q');
let lookupError: string | null = null;
if (rawQuery !== null) {
  const query = rawQuery.trim().replace(/^#/, '');
  if (query !== '') {
    const bareToken = parsePublicId(
      `ord_${query.toLowerCase()}`,
      'order',
    );
    const candidates = [
      parseOrderOrLegacyPublicId(query, 'order'),
      query.length === PUBLIC_ID_TOKEN_LENGTH ? bareToken : null,
      await findOrderPublicIdByReference(env.DB, query),
    ].filter((c): c is string => c !== null);
    for (const candidate of candidates) {
      const found = await getOrderByPublicId(env.DB, candidate);
      if (found) return Astro.redirect(`/admin/orders/${found.public_id}`, 302);
    }
    lookupError = `No order matches “${query}”.`;
  }
}

const PAGE_SIZE = 150;
const orders = await listOrders(env.DB, PAGE_SIZE, 'created_at DESC');
const onCfg = getConfig().orderNumber;
const timeZone = Astro.locals.settings?.timeZone ?? getConfig().timeZone;

// Refunds a provider reported that no order claims
const unmatched = await listUnmatchedRefundEvents(env.DB);
const inventoryExceptions = await listUnresolvedInventoryExceptions(env.DB);
const conflictOrders = new Map(
  await Promise.all(
    unmatched
      .filter((e) => e.order_id != null)
      .map(async (e) => [e.order_id!, await getOrder(env.DB, e.order_id!)] as const),
  ),
);
const listError = Astro.url.searchParams.get('error');

const tableOrders: OrderItem[] = orders.map((o) => ({
  id: o.id,
  public_id: o.public_id,
  email: o.email,
  amount_total_cents: o.amount_total_cents,
  currency: o.currency,
  status: o.status,
  fulfillment_status: o.fulfillment_status,
  payment_method: o.payment_method,
  created_at: o.created_at,
}));
---

<AdminLayout title="Orders" active="orders">
  {
    inventoryExceptions.length > 0 && (
      <section id="inventory-exceptions" class="mb-6 rounded-xl border border-red-200 bg-red-50 p-4 shadow-2xs">
        <h2 class="text-sm font-semibold text-red-900">{inventoryExceptions.length} inventory exception{inventoryExceptions.length === 1 ? '' : 's'} need attention</h2>
        <p class="mt-1 text-xs text-red-700">These paid orders arrived after their stock holds ended. Open each order to reconcile the oversold quantity.</p>
        <ul class="mt-3 space-y-1.5 text-xs text-red-900">
          {inventoryExceptions.map((entry) => (
            <li>
              <a class="font-medium underline" href={`/admin/orders/${entry.order_public_id}`}>
                Order #{orderReference(entry.order_public_id, entry.order_id, onCfg)}
              </a>{' '}
              — {entry.shortfall_qty} unit{entry.shortfall_qty === 1 ? '' : 's'} oversold
            </li>
          ))}
        </ul>
      </section>
    )
  }
  {
    listError && (
      <p class="mb-6 rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-800">
        {listError}
      </p>
    )
  }
  {
    unmatched.length > 0 && (
      <section class="mb-6 rounded-xl border border-amber-200 bg-amber-50 p-4 shadow-2xs">
        <h2 class="text-sm font-semibold text-amber-900">
          {unmatched.length} refund{unmatched.length === 1 ? '' : 's'} need{unmatched.length === 1 ? 's' : ''} attention
        </h2>
        <p class="mt-1 text-xs text-amber-700">
          Your payment provider reported these refunds but they could not be applied. Nothing was
          counted against your revenue yet.
        </p>
        <ul class="mt-3 space-y-2">
          {unmatched.map((e) => (
            <li class="flex flex-wrap items-center gap-3 text-xs text-amber-900">
              <span class="font-mono">{e.provider_payment_id ?? '—'}</span>
              <span class="tabular-nums font-medium">
                {formatPrice(e.cumulative_refunded_cents, e.currency ?? undefined)}
              </span>
              <span class="text-amber-700">{formatDate(e.created_at, undefined, timeZone)}</span>
              {e.order_id && conflictOrders.get(e.order_id) ? (
                <Fragment>
                  <span>
                    Conflicts with{' '}
                    <a
                      href={`/admin/orders/${conflictOrders.get(e.order_id)!.public_id}`}
                      class="underline font-medium"
                    >
                      order #{orderReference(
                        conflictOrders.get(e.order_id)!.public_id,
                        e.order_id,
                        onCfg,
                      )}
                    </a>
                    {e.last_error ? ` — ${e.last_error.replace(/_/g, ' ')}` : ''}
                  </span>
                  <form method="POST" action="/api/admin/refunds">
                    <input type="hidden" name="_action" value="dismiss_refund_event" />
                    <input type="hidden" name="event_id" value={e.provider_event_id} />
                    <button
                      type="submit"
                      class="rounded-md border border-amber-300 bg-white px-2.5 py-1 text-xs font-medium hover:bg-amber-100 transition-colors"
                    >
                      Dismiss
                    </button>
                  </form>
                </Fragment>
              ) : (
                <Fragment>
                  <span>No order records this payment</span>
                  <form method="POST" action="/api/admin/refunds">
                    <input type="hidden" name="_action" value="retry_refund_event" />
                    <input type="hidden" name="event_id" value={e.provider_event_id} />
                    <button
                      type="submit"
                      class="rounded-md border border-amber-300 bg-white px-2.5 py-1 text-xs font-medium hover:bg-amber-100 transition-colors"
                    >
                      Retry
                    </button>
                  </form>
                </Fragment>
              )}
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
    <div>
      <h1 class="font-serif text-3xl tracking-tight">Orders</h1>
      <p class="text-xs text-muted mt-1">Track orders, customer payments, and fulfillment</p>
    </div>
    <div class="flex flex-wrap items-center gap-3">
      <form method="GET" action="/admin/orders" class="flex items-center gap-2">
        <input
          type="search"
          name="q"
          value={rawQuery ?? ''}
          placeholder="Jump to Order # or ID"
          aria-label="Find an order by number or ID"
          class="w-48 rounded-lg border border-line bg-paper/50 px-3 py-1.5 text-xs text-ink placeholder:text-gray-400 focus:border-brand focus:bg-white focus:outline-none"
        />
        <button
          type="submit"
          class="rounded-lg border border-line bg-white px-3 py-1.5 text-xs font-medium text-ink hover:border-brand hover:text-brand transition-colors"
        >
          Find
        </button>
      </form>
      <a
        href="/admin/orders/export.csv"
        class="inline-flex items-center gap-1.5 rounded-lg border border-line bg-white px-3 py-1.5 text-xs font-medium text-ink hover:border-brand hover:text-brand transition-colors"
      >
        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
        </svg>
        Export CSV
      </a>
    </div>
  </div>

  {
    lookupError && (
      <p class="mb-6 rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-800">
        {lookupError}
      </p>
    )
  }

  <AdminOrderTable orders={tableOrders} timeZone={timeZone} />
</AdminLayout>
