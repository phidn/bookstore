---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getConfig } from '../../../config';
import { listCustomers } from '../../../features/customers/db';
import AdminCustomerTable from '../../../components/AdminCustomerTable.astro';

const PAGE_SIZE = 200;
const customers = await listCustomers(env.DB, 'lifetime_cents DESC', PAGE_SIZE, 0);
const timeZone = Astro.locals.settings?.timeZone ?? getConfig().timeZone;
---

<AdminLayout title="Customers" active="customers">
  <div class="mb-6 flex items-center justify-between">
    <div>
      <h1 class="font-serif text-3xl tracking-tight">Customers</h1>
      <p class="text-xs text-muted mt-1">View customer history, orders, and lifetime value</p>
    </div>
  </div>

  <AdminCustomerTable customers={customers} timeZone={timeZone} />
</AdminLayout>
