---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { menuReferencesFor } from '../../../features/navigation/admin';
import {
  listCategories,
  buildTree,
  flattenTree,
  productCounts,
} from '../../../features/categories/db';
import AdminCategoryTable from '../../../components/AdminCategoryTable.astro';

const rows = flattenTree(buildTree(await listCategories(env.DB)));
const counts = await productCounts(env.DB);
const menuRefs = await menuReferencesFor(env.DB, 'category', rows.map((r) => r.id));

const tableCategories = rows.map((c) => ({
  id: c.id,
  public_id: c.public_id,
  name: c.name,
  slug: c.slug,
  depth: c.depth,
  productCount: counts.get(c.id) ?? 0,
  isLinkedNav: menuRefs.has(c.id),
}));
---

<AdminLayout title="Categories" active="categories">
  <div class="mb-6 flex items-center justify-between">
    <div>
      <h1 class="font-serif text-3xl tracking-tight">Categories</h1>
      <p class="text-xs text-muted mt-1">Organize products into hierarchical categories</p>
    </div>
    <a
      href="/admin/categories/new"
      class="inline-flex items-center gap-1.5 rounded-lg bg-brand px-4 py-2 text-xs font-medium uppercase tracking-wider text-white shadow-xs hover:bg-brand-hover transition-colors"
    >
      <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
      </svg>
      New category
    </a>
  </div>

  <AdminCategoryTable categories={tableCategories} />
</AdminLayout>
