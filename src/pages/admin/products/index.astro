---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getConfig } from '../../../config';
import { listAllProducts } from '../../../features/products/db';
import { orderByClause } from '../../../features/products/sort';
import { menuReferencesFor } from '../../../features/navigation/admin';
import {
  parseProductFilters,
  productFilterClause,
} from '../../../features/products/filter';
import AdminProductTable from '../../../components/AdminProductTable.astro';

// Auth: /admin + /api/admin are gated by src/middleware.ts. The admin password is
// set in the first-run setup wizard (hashed in D1); Cloudflare Access at the edge
// is the recommended production layer — see README → Admin auth.

const sort = Astro.url.searchParams.get('sort');
const dir = Astro.url.searchParams.get('dir');
const order = orderByClause(sort, dir);

const filters = parseProductFilters(Astro.url.searchParams);
const filterClause = productFilterClause(filters);

const PAGE_SIZE = 100;
const products = await listAllProducts(env.DB, PAGE_SIZE, 0, order, filterClause);
const menuRefs = await menuReferencesFor(env.DB, 'product', products.map((p) => p.id));
const config = getConfig();

const tableProducts = products.map((p) => ({
  id: p.id,
  public_id: p.public_id,
  name: p.name,
  slug: p.slug,
  price_cents: p.price_cents,
  currency: p.currency,
  image_key: p.image_key,
  stock: p.stock,
  active: p.active,
  sold: p.sold,
  isLinkedNav: menuRefs.has(p.id),
}));
---

<AdminLayout title="Products" active="products">
  <div class="mb-6 flex items-center justify-between">
    <div>
      <h1 class="font-serif text-3xl tracking-tight">Products</h1>
      <p class="text-xs text-muted mt-1">Manage catalog, inventory, and visibility</p>
    </div>
    <a
      href="/admin/products/new"
      class="inline-flex items-center gap-1.5 rounded-lg bg-brand px-4 py-2 text-xs font-medium uppercase tracking-wider text-white shadow-xs hover:bg-brand-hover transition-colors"
    >
      <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
      </svg>
      New product
    </a>
  </div>

  <AdminProductTable products={tableProducts} baseUrl={config.images.baseUrl} />
</AdminLayout>
