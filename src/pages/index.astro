---
import { env } from 'cloudflare:workers';
import Layout from '../layouts/Layout.astro';
import HomePage from '#theme/HomePage.astro';
import { loadCatalogPage } from '../features/storefront/catalog';
import { getConfig } from '../config';
import { resolveHomePath } from '../features/settings/home';

// A store can point `/` at a page or a single product instead of the catalog.
// Rewriting rather than duplicating those templates keeps one implementation of
// each, and it makes the canonical URL resolve to the real page — so the same
// content served at `/` and at `/pages/<slug>` is not two indexable copies.
// Anything unresolvable (never set, unpublished, deleted, deactivated) falls
// through to the catalog: a 404 homepage would be edge-cached for everyone.
const homePath = await resolveHomePath(env.DB, Astro.locals.settings?.homePage);
if (homePath) return Astro.rewrite(homePath);

const config = getConfig();
const environment = config.environment;
const envTag =
  environment === 'production'
    ? null
    : environment === 'staging'
      ? 'STAGING'
      : environment === 'demo'
        ? 'DEMO'
        : 'LOCAL';
const catalog = await loadCatalogPage(env.DB, {
  base: '/products',
  searchParams: new URLSearchParams(),
  responseHeaders: Astro.response.headers,
  imageBaseUrl: config.images.baseUrl,
  currency: config.currency,
  delivery: Astro.locals.settings?.imageDelivery,
  eyebrow: 'Sách',
  heading: 'Sách tuyển chọn',
  envTag,
});
---

<Layout
  description="Tiểu Viện Hữu Thư — Một tiểu viện nhỏ có nhiều chuyện để nói với nhau nghe. Tiểu viện có bán sách cũ."
  image="/og-image.jpg"
>
  <HomePage
    featuredBooks={catalog.products.slice(0, 6)}
    storeName={Astro.locals.settings?.storeName ?? config.storeName}
  />
</Layout>
