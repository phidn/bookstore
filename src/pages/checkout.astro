---
export const prerender = false;

import { env } from 'cloudflare:workers';
import Layout from '../layouts/Layout.astro';
import { formatPrice, getConfig } from '../config';
import { readCart, resolveCart } from '../features/cart/cart';
import { getProductByPublicId, type Product } from '../features/products/db';
import {
  getExtrasByPublicIds,
  listVariants,
  type ProductVariant,
} from '../features/products/variants';
import { parsePublicId } from '../features/ids/publicId';
import { lineUnitPriceCents } from '../features/cart/key';
import {
  claimOrderIdentity,
  deleteGuestAccessIfUnsettled,
} from '../features/orders/guestAccess';
import {
  getSettlementReservation,
  releaseInventoryReservation,
  reserveInventory,
} from '../features/orders/reservations';
import { reservationItems } from '../features/orders/reservationItems';
import { recordPaidOrder } from '../features/orders/db';
import { deliverOrderNotifications, sweepStaleNotifications } from '../features/email/outbox';
import { purgeStockProductCache } from '../features/cache/purge';
import {
  isLocalPaymentMethod,
  localCommerce,
  type LocalPaymentMethod,
} from '../local-commerce';

interface CheckoutLine {
  product: Product;
  qty: number;
  name: string;
  unitPriceCents: number;
  variantId: number | null;
  availableStock: number;
}

const isPost = Astro.request.method === 'POST';
const form = isPost ? await Astro.request.formData() : null;
const fld = (name: string) => String(form?.get(name) ?? '').trim();
const queryOrField = (name: string) => fld(name) || Astro.url.searchParams.get(name) || '';

const productPublicId = parsePublicId(queryOrField('product_id'), 'product');
const variantPublicId = parsePublicId(queryOrField('variant_id'), 'variant');
const extraInputs = isPost ? form!.getAll('extra') : Astro.url.searchParams.getAll('extra');
const extraPublicIds = extraInputs
  .map((value) => parsePublicId(value, 'extra'))
  .filter((value): value is string => value !== null);

let lines: CheckoutLine[] = [];
if (productPublicId) {
  const product = await getProductByPublicId(env.DB, productPublicId);
  if (product?.active) {
    const variants = await listVariants(env.DB, product.id);
    const variant: ProductVariant | null = variantPublicId
      ? variants.find((entry) => entry.public_id === variantPublicId) ?? null
      : null;
    if (variants.length > 0 && !variant) {
      return Astro.redirect(
        `/products/${product.slug}?error=${encodeURIComponent(`Vui lòng chọn ${product.variant_label || 'phân loại'}.`)}`,
        303,
      );
    }
    const extras = extraPublicIds.length
      ? await getExtrasByPublicIds(env.DB, product.id, extraPublicIds)
      : [];
    lines = [
      {
        product,
        qty: 1,
        name:
          product.name +
          (variant ? ` — ${variant.label}` : '') +
          (extras.length ? ` (${extras.map((entry) => entry.label).join(', ')})` : ''),
        unitPriceCents: lineUnitPriceCents(product.price_cents, variant, extras),
        variantId: variant?.id ?? null,
        availableStock: variant?.stock ?? product.stock,
      },
    ];
  }
} else {
  const cart = await resolveCart(env.DB, readCart(Astro.cookies));
  lines = cart.lines.map((line) => ({
    product: line.product,
    qty: line.qty,
    name:
      line.product.name +
      (line.variant ? ` — ${line.variant.label}` : '') +
      (line.extras.length ? ` (${line.extras.map((entry) => entry.label).join(', ')})` : ''),
    unitPriceCents: line.unitPriceCents,
    variantId: line.variant?.id ?? null,
    availableStock: line.availableStock,
  }));
}
if (lines.length === 0) return Astro.redirect('/cart', 303);

const subtotalCents = lines.reduce((sum, line) => sum + line.unitPriceCents * line.qty, 0);
const totalCents = subtotalCents + localCommerce.shippingCents;
const paymentRaw = fld('payment_method');
const paymentMethod: LocalPaymentMethod = isLocalPaymentMethod(paymentRaw) ? paymentRaw : 'cod';
const customer = {
  name: fld('name'),
  phone: fld('phone'),
  email: fld('email'),
  address: fld('address'),
};
const errors: string[] = [];

if (isPost) {
  if (!customer.name) errors.push('Vui lòng nhập họ và tên.');
  const phoneDigits = customer.phone.replace(/\D/g, '');
  if (!/^(0|84)[0-9]{9}$/.test(phoneDigits)) errors.push('Vui lòng nhập số điện thoại Việt Nam hợp lệ.');
  if (!/.+@.+\..+/.test(customer.email)) errors.push('Vui lòng nhập email hợp lệ.');
  if (!customer.address) errors.push('Vui lòng nhập đầy đủ địa chỉ nhận hàng tại TP.HCM.');
  const short = lines.find((line) => line.availableStock < line.qty);
  if (short) errors.push(`${short.name} hiện không còn đủ số lượng.`);

  if (errors.length === 0) {
    const { publicId, accessToken } = await claimOrderIdentity(env.DB);
    const reserved = await reserveInventory(
      env.DB,
      publicId,
      reservationItems(lines),
      7 * 24 * 60 * 60,
      paymentMethod,
      purgeStockProductCache,
    );
    if (!reserved) {
      await deleteGuestAccessIfUnsettled(env.DB, publicId);
      errors.push('Một cuốn sách vừa được người khác đặt trước. Vui lòng kiểm tra lại giỏ hàng.');
    } else {
      const reservation = await getSettlementReservation(env.DB, publicId);
      try {
        if (!reservation) throw new Error('Không đọc được dữ liệu giữ hàng.');
        const orderId = await recordPaidOrder(
          env.DB,
          {
            providerSessionId: `local_${publicId}`,
            publicId,
            reservationId: publicId,
            reservationStatus: 'active',
            email: customer.email,
            amountTotalCents: totalCents,
            shippingCents: localCommerce.shippingCents,
            shippingLabel: localCommerce.shippingLabel,
            shippingWeightGrams: null,
            deliveryMethod: 'shipping',
            shippingAddress: {
              name: customer.name,
              phone: customer.phone,
              line1: customer.address,
              line2: null,
              city: localCommerce.city,
              state: null,
              postal: '700000',
              country: localCommerce.country,
            },
            currency: getConfig().currency,
            status: 'pending',
            paymentMethod,
            items: reservation.items,
          },
          purgeStockProductCache,
        );
        if (!orderId) throw new Error('Không thể ghi nhận đơn hàng.');

        try {
          const origin = Astro.url.origin;
          await deliverOrderNotifications(env.DB, orderId, origin);
          await sweepStaleNotifications(env.DB, origin);
        } catch (deliveryError) {
          console.error('Order notification delivery failed:', deliveryError);
        }

        return Astro.redirect(`/order/${accessToken}`, 303);
      } catch (error) {
        await releaseInventoryReservation(env.DB, publicId, purgeStockProductCache);
        await deleteGuestAccessIfUnsettled(env.DB, publicId);
        console.error('Local checkout failed:', error);
        errors.push('Chưa thể ghi nhận đơn hàng. Vui lòng thử lại.');
      }
    }
  }
}

const carryProduct = productPublicId ?? '';
const carryVariant = variantPublicId ?? '';
---

<Layout title="Đặt hàng" description="Giao sách nội thành TP.HCM.">
  <div class="mx-auto grid max-w-5xl gap-8 lg:grid-cols-[1.2fr_0.8fr]">
    <section>
      <h1 class="font-serif text-3xl tracking-tight sm:text-4xl">Thông tin giao hàng</h1>
      <p class="mt-2 text-sm text-muted">Tiểu Viện hiện giao sách trong nội thành TP.HCM.</p>

      {errors.length > 0 && (
        <ul class="mt-5 rounded-md border border-red-200 bg-red-50 p-4 text-sm text-red-700">
          {errors.map((error) => <li>{error}</li>)}
        </ul>
      )}

      <form method="POST" action="/checkout" class="mt-6 space-y-4">
        {carryProduct && <input type="hidden" name="product_id" value={carryProduct} />}
        {carryVariant && <input type="hidden" name="variant_id" value={carryVariant} />}
        {extraPublicIds.map((id) => <input type="hidden" name="extra" value={id} />)}

        <label class="block">
          <span class="mb-1 block text-sm font-medium">Họ và tên</span>
          <input name="name" value={customer.name} autocomplete="name" required class="w-full rounded-md border border-line bg-paper px-3 py-3 focus:border-brand focus:outline-none" />
        </label>
        <label class="block">
          <span class="mb-1 block text-sm font-medium">Số điện thoại</span>
          <input name="phone" value={customer.phone} autocomplete="tel" inputmode="tel" required placeholder="09xxxxxxxx" class="w-full rounded-md border border-line bg-paper px-3 py-3 focus:border-brand focus:outline-none" />
        </label>
        <label class="block">
          <span class="mb-1 block text-sm font-medium">Email</span>
          <input name="email" type="email" value={customer.email} autocomplete="email" required class="w-full rounded-md border border-line bg-paper px-3 py-3 focus:border-brand focus:outline-none" />
        </label>
        <label class="block">
          <span class="mb-1 block text-sm font-medium">Địa chỉ nhận hàng</span>
          <input name="address" value={customer.address} autocomplete="street-address" required placeholder="Số nhà, tên đường, phường/xã, quận/huyện" class="w-full rounded-md border border-line bg-paper px-3 py-3 focus:border-brand focus:outline-none" />
        </label>
        <label class="block">
          <span class="mb-1 block text-sm font-medium">Thành phố</span>
          <input value="Hồ Chí Minh" disabled class="w-full cursor-not-allowed rounded-md border border-line bg-surface px-3 py-3 text-muted opacity-80" />
        </label>

        <fieldset class="rounded-lg border border-line p-4">
          <legend class="px-1 font-medium">Phương thức thanh toán</legend>
          <label class="mt-2 flex cursor-pointer items-start gap-3 rounded-md border border-line p-3">
            <input type="radio" name="payment_method" value="cod" checked={paymentMethod === 'cod'} class="mt-1 accent-brand" />
            <span><strong class="block">Thanh toán khi giao hàng (COD)</strong><small class="text-muted">Thanh toán cho đơn vị giao hàng khi nhận sách.</small></span>
          </label>
          <label class="mt-3 flex cursor-pointer items-start gap-3 rounded-md border border-line p-3">
            <input type="radio" name="payment_method" value="bank_transfer" checked={paymentMethod === 'bank_transfer'} class="mt-1 accent-brand" />
            <span><strong class="block">Thanh toán chuyển khoản</strong><small class="text-muted">Thanh toán chuyển khoản trực tiếp ở bước tiếp theo.</small></span>
          </label>
        </fieldset>

        <button type="submit" class="w-full rounded-md bg-brand px-5 py-3 font-medium text-on-brand hover:bg-brand-hover">Đặt hàng</button>
        <a href="/cart" class="block text-center text-sm text-muted hover:text-brand">Quay lại giỏ hàng</a>
      </form>
    </section>

    <aside class="h-fit rounded-lg border border-line bg-surface p-5 lg:sticky lg:top-28">
      <h2 class="font-serif text-2xl">Đơn hàng</h2>
      <ul class="mt-4 divide-y divide-line text-sm">
        {lines.map((line) => (
          <li class="flex justify-between gap-4 py-3">
            <span>{line.name} <span class="text-muted">× {line.qty}</span></span>
            <span class="shrink-0 tabular-nums">{formatPrice(line.unitPriceCents * line.qty)}</span>
          </li>
        ))}
      </ul>
      <div class="mt-3 space-y-2 border-t border-line pt-3 text-sm">
        <div class="flex justify-between"><span>Tổng tiền hàng</span><span>{formatPrice(subtotalCents)}</span></div>
        <div class="flex justify-between"><span>{localCommerce.shippingLabel}</span><span>{formatPrice(localCommerce.shippingCents)}</span></div>
        <div class="flex justify-between border-t border-line pt-3 text-base font-semibold"><span>Tổng thanh toán</span><span>{formatPrice(totalCents)}</span></div>
      </div>
    </aside>
  </div>
</Layout>
