---
import { formatPrice, formatDate } from '../config';
import { truncatePublicId } from '../features/ids/publicId';

export interface OrderItem {
  id: number;
  public_id: string | null;
  email: string | null;
  amount_total_cents: number;
  currency: string;
  status: string;
  fulfillment_status: string;
  payment_method: string | null;
  created_at: string;
}

interface Props {
  orders: OrderItem[];
  timeZone?: string;
}

const { orders, timeZone } = Astro.props;

// Precompute display data for SSR and client hydration
const initialData = orders.map((o) => ({
  ...o,
  displayId: `#${o.id}`,
  shortPublicId: o.public_id ? truncatePublicId(o.public_id, 'order') : '—',
  formattedTotal: formatPrice(o.amount_total_cents, o.currency),
  formattedDate: formatDate(o.created_at, undefined, timeZone),
  encodedEmail: o.email ? encodeURIComponent(o.email) : '',
}));
---

<div id="tanstack-order-table-root" class="space-y-4">
  <!-- Controls Bar (Live Search & Quick Filters) -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 bg-white p-3 rounded-xl border border-line shadow-2xs">
    <div class="flex flex-1 flex-wrap items-center gap-3">
      <!-- Search Input -->
      <div class="relative flex-1 min-w-[200px] max-w-sm">
        <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-gray-400">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
        <input
          type="text"
          id="order-search-input"
          placeholder="Search orders by #, ID, customer email..."
          class="w-full rounded-lg border border-line bg-paper/50 py-1.5 pl-9 pr-3 text-sm text-ink placeholder:text-gray-400 focus:border-brand focus:bg-white focus:outline-none focus:ring-1 focus:ring-brand"
        />
      </div>

      <!-- Quick Filter: Payment Status -->
      <select
        id="order-status-filter"
        class="rounded-lg border border-line bg-paper/50 px-2.5 py-1.5 text-xs font-medium text-muted focus:border-brand focus:bg-white focus:outline-none"
      >
        <option value="all">All payments</option>
        <option value="paid">Paid</option>
        <option value="refunded">Refunded</option>
        <option value="pending">Pending</option>
        <option value="failed">Failed</option>
      </select>

      <!-- Quick Filter: Fulfillment -->
      <select
        id="order-fulfillment-filter"
        class="rounded-lg border border-line bg-paper/50 px-2.5 py-1.5 text-xs font-medium text-muted focus:border-brand focus:bg-white focus:outline-none"
      >
        <option value="all">Any fulfillment</option>
        <option value="unfulfilled">Unfulfilled</option>
        <option value="fulfilled">Fulfilled</option>
      </select>

      <!-- Quick Filter: Method -->
      <select
        id="order-method-filter"
        class="rounded-lg border border-line bg-paper/50 px-2.5 py-1.5 text-xs font-medium text-muted focus:border-brand focus:bg-white focus:outline-none"
      >
        <option value="all">All methods</option>
        <option value="stripe">Stripe</option>
        <option value="lightning">Lightning</option>
        <option value="opennode">OpenNode</option>
      </select>
    </div>

    <!-- Match counter -->
    <div class="text-xs text-muted flex items-center gap-1.5 shrink-0 self-end sm:self-center">
      <span>Found</span>
      <span id="order-count-badge" class="font-semibold text-ink">{orders.length}</span>
      <span>orders</span>
    </div>
  </div>

  <!-- Modern Table Container -->
  <div class="overflow-hidden rounded-xl border border-line bg-white shadow-2xs">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm table-fixed min-w-[860px]" id="admin-tanstack-order-table">
        <colgroup>
          <col class="w-[10%]" />
          <col class="w-[16%]" />
          <col class="w-[24%]" />
          <col class="w-[12%]" />
          <col class="w-[11%]" />
          <col class="w-[12%]" />
          <col class="w-[15%]" />
        </colgroup>
        <thead class="border-b border-line bg-paper/70 text-xs font-semibold uppercase tracking-wider text-muted select-none">
          <tr>
            <th class="py-3.5 px-4 cursor-pointer hover:text-brand transition-colors" data-sort="id">
              <div class="flex items-center gap-1.5">
                <span>Order #</span>
                <span class="sort-icon text-gray-300 text-2xs">↕</span>
              </div>
            </th>
            <th class="py-3.5 px-3 font-semibold">Public ID</th>
            <th class="py-3.5 px-3 cursor-pointer hover:text-brand transition-colors" data-sort="email">
              <div class="flex items-center gap-1.5">
                <span>Email</span>
                <span class="sort-icon text-gray-300 text-2xs">↕</span>
              </div>
            </th>
            <th class="py-3.5 px-3 cursor-pointer hover:text-brand transition-colors whitespace-nowrap" data-sort="amount_total_cents">
              <div class="flex items-center gap-1.5">
                <span>Total</span>
                <span class="sort-icon text-gray-300 text-2xs">↕</span>
              </div>
            </th>
            <th class="py-3.5 px-3 text-center cursor-pointer hover:text-brand transition-colors whitespace-nowrap" data-sort="status">
              <div class="inline-flex items-center gap-1.5 justify-center">
                <span>Status</span>
                <span class="sort-icon text-gray-300 text-2xs">↕</span>
              </div>
            </th>
            <th class="py-3.5 px-3 text-center cursor-pointer hover:text-brand transition-colors whitespace-nowrap" data-sort="fulfillment_status">
              <div class="inline-flex items-center gap-1.5 justify-center">
                <span>Fulfillment</span>
                <span class="sort-icon text-gray-300 text-2xs">↕</span>
              </div>
            </th>
            <th class="py-3.5 px-4 text-right cursor-pointer hover:text-brand transition-colors whitespace-nowrap" data-sort="created_at">
              <div class="inline-flex items-center gap-1.5 justify-end w-full">
                <span>When</span>
                <span class="sort-icon text-gray-300 text-2xs">↕</span>
              </div>
            </th>
          </tr>
        </thead>
        <tbody id="order-table-body" class="divide-y divide-line/70">
          {
            initialData.slice(0, 30).map((o) => (
              <tr class="hover:bg-paper/40 transition-colors group">
                <!-- Order # -->
                <td class="py-3 px-4 tabular-nums">
                  <a
                    href={`/admin/orders/${o.public_id}`}
                    class="font-semibold text-accent hover:underline"
                  >
                    #{o.id}
                  </a>
                </td>

                <!-- Public ID -->
                <td class="py-3 px-3 font-mono text-xs">
                  <a
                    href={`/admin/orders/${o.public_id}`}
                    title={o.public_id ?? undefined}
                    class="text-accent hover:underline block truncate"
                  >
                    {o.shortPublicId}
                  </a>
                </td>

                <!-- Email -->
                <td class="py-3 px-3 max-w-0">
                  {o.email ? (
                    <a
                      href={`/admin/customers/${o.encodedEmail}`}
                      title={o.email}
                      class="text-ink hover:text-brand font-medium block truncate"
                    >
                      {o.email}
                    </a>
                  ) : (
                    <span class="text-gray-400">—</span>
                  )}
                </td>

                <!-- Total -->
                <td class="py-3 px-3 font-medium text-ink tabular-nums whitespace-nowrap">
                  {o.formattedTotal}
                </td>

                <!-- Payment Status Badge -->
                <td class="py-3 px-3 text-center whitespace-nowrap">
                  {o.status === 'paid' ? (
                    <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-50 px-2.5 py-0.5 text-xs font-medium text-emerald-700 ring-1 ring-inset ring-emerald-600/20">
                      <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span> Paid
                    </span>
                  ) : o.status === 'refunded' ? (
                    <span class="inline-flex items-center gap-1.5 rounded-full bg-amber-50 px-2.5 py-0.5 text-xs font-medium text-amber-700 ring-1 ring-inset ring-amber-600/20">
                      <span class="h-1.5 w-1.5 rounded-full bg-amber-500"></span> Refunded
                    </span>
                  ) : (
                    <span class="inline-flex items-center gap-1.5 rounded-full bg-gray-100 px-2.5 py-0.5 text-xs font-medium text-gray-600 ring-1 ring-inset ring-gray-500/20">
                      <span class="h-1.5 w-1.5 rounded-full bg-gray-400"></span> {o.status}
                    </span>
                  )}
                </td>

                <!-- Fulfillment Badge -->
                <td class="py-3 px-3 text-center whitespace-nowrap">
                  {o.fulfillment_status === 'fulfilled' ? (
                    <span class="inline-flex items-center gap-1.5 rounded-full bg-blue-50 px-2.5 py-0.5 text-xs font-medium text-blue-700 ring-1 ring-inset ring-blue-600/20">
                      <span class="h-1.5 w-1.5 rounded-full bg-blue-500"></span> Fulfilled
                    </span>
                  ) : (
                    <span class="inline-flex items-center gap-1.5 rounded-full bg-gray-100 px-2.5 py-0.5 text-xs font-medium text-gray-500 ring-1 ring-inset ring-gray-400/20">
                      Unfulfilled
                    </span>
                  )}
                </td>

                <!-- When -->
                <td class="py-3 px-4 text-right text-muted whitespace-nowrap text-xs">
                  {o.formattedDate}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <!-- Empty State -->
    <div id="order-table-empty-state" class={initialData.length === 0 ? 'py-12 text-center text-muted' : 'hidden py-12 text-center text-muted'}>
      <svg class="mx-auto h-8 w-8 text-gray-300 mb-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
      </svg>
      <p class="text-sm">No orders found matching the criteria.</p>
    </div>

    <!-- Table Footer / Pagination Controls -->
    <div class="flex items-center justify-between border-t border-line bg-paper/40 px-4 py-3 text-xs text-muted">
      <div class="flex items-center gap-2">
        <span>Rows per page:</span>
        <select
          id="order-page-size-select"
          class="rounded-md border border-line bg-white px-2 py-1 text-xs text-ink focus:outline-none"
        >
          <option value="15">15</option>
          <option value="30" selected>30</option>
          <option value="50">50</option>
          <option value="100">100</option>
        </select>
        <span id="order-page-info-label" class="ml-2">Page 1 of {Math.ceil(orders.length / 30) || 1}</span>
      </div>

      <div class="flex items-center gap-1.5">
        <button
          id="order-btn-prev-page"
          disabled
          class="rounded-md border border-line bg-white px-2.5 py-1 font-medium text-ink disabled:opacity-40 disabled:cursor-not-allowed hover:bg-paper transition-colors"
        >
          Previous
        </button>
        <button
          id="order-btn-next-page"
          disabled={orders.length <= 30}
          class="rounded-md border border-line bg-white px-2.5 py-1 font-medium text-ink disabled:opacity-40 disabled:cursor-not-allowed hover:bg-paper transition-colors"
        >
          Next
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Hydration Data -->
<script id="order-tanstack-data" type="application/json" is:inline set:html={JSON.stringify(initialData)} />

<script>
  import {
    constructTable,
    tableFeatures,
    stockFeatures,
    createFilteredRowModel,
    createSortedRowModel,
    createPaginatedRowModel,
    type SortingState,
    type ColumnFiltersState,
  } from '@tanstack/table-core';
  import { storeReactivityBindings } from '@tanstack/table-core/store-reactivity-bindings';

  interface OrderRow {
    id: number;
    public_id: string | null;
    email: string | null;
    amount_total_cents: number;
    currency: string;
    status: string;
    fulfillment_status: string;
    payment_method: string | null;
    created_at: string;
    displayId: string;
    shortPublicId: string;
    formattedTotal: string;
    formattedDate: string;
    encodedEmail: string;
  }

  const rawDataElement = document.getElementById('order-tanstack-data');
  if (rawDataElement) {
    const rawOrders: OrderRow[] = JSON.parse(rawDataElement.textContent || '[]');

    let sorting: SortingState = [{ id: 'created_at', desc: true }];
    let columnFilters: ColumnFiltersState = [];
    let globalFilter = '';
    let pagination = {
      pageIndex: 0,
      pageSize: 30,
    };

    const columns = [
      {
        accessorKey: 'id',
        header: 'Order #',
      },
      {
        accessorKey: 'public_id',
        header: 'Public ID',
      },
      {
        accessorKey: 'email',
        header: 'Email',
      },
      {
        accessorKey: 'amount_total_cents',
        header: 'Total',
      },
      {
        accessorKey: 'status',
        header: 'Status',
        filterFn: (row: any, _columnId: string, filterValue: string) => {
          return row.original.status === filterValue;
        },
      },
      {
        accessorKey: 'fulfillment_status',
        header: 'Fulfillment',
        filterFn: (row: any, _columnId: string, filterValue: string) => {
          return row.original.fulfillment_status === filterValue;
        },
      },
      {
        accessorKey: 'payment_method',
        header: 'Method',
        filterFn: (row: any, _columnId: string, filterValue: string) => {
          return (row.original.payment_method || '').toLowerCase() === filterValue.toLowerCase();
        },
      },
      {
        accessorKey: 'created_at',
        header: 'When',
      },
    ];

    // Initialize TanStack Table instance (v9 API)
    const table = constructTable({
      features: tableFeatures({
        ...stockFeatures,
        coreReactivityFeature: storeReactivityBindings(),
        filteredRowModel: createFilteredRowModel(),
        sortedRowModel: createSortedRowModel(),
        paginatedRowModel: createPaginatedRowModel(),
      }),
      data: rawOrders,
      columns: columns as any,
      initialState: {
        sorting,
        columnFilters,
        globalFilter,
        pagination,
      },
      globalFilterFn: (row: any, _columnId: string, filterValue: unknown) => {
        const query = String(filterValue || '').toLowerCase().trim();
        if (!query) return true;
        const id = String(row.original?.id || '');
        const publicId = String(row.original?.public_id || '').toLowerCase();
        const email = String(row.original?.email || '').toLowerCase();
        const total = String(row.original?.formattedTotal || '').toLowerCase();
        const status = String(row.original?.status || '').toLowerCase();
        const fulfillment = String(row.original?.fulfillment_status || '').toLowerCase();
        const method = String(row.original?.payment_method || '').toLowerCase();
        return (
          id.includes(query) ||
          publicId.includes(query) ||
          email.includes(query) ||
          total.includes(query) ||
          status.includes(query) ||
          fulfillment.includes(query) ||
          method.includes(query)
        );
      },
    });

    const tbody = document.getElementById('order-table-body');
    const emptyState = document.getElementById('order-table-empty-state');
    const countBadge = document.getElementById('order-count-badge');
    const pageInfoLabel = document.getElementById('order-page-info-label');
    const btnPrev = document.getElementById('order-btn-prev-page') as HTMLButtonElement | null;
    const btnNext = document.getElementById('order-btn-next-page') as HTMLButtonElement | null;
    const pageSizeSelect = document.getElementById('order-page-size-select') as HTMLSelectElement | null;
    const searchInput = document.getElementById('order-search-input') as HTMLInputElement | null;
    const statusSelect = document.getElementById('order-status-filter') as HTMLSelectElement | null;
    const fulfillmentSelect = document.getElementById('order-fulfillment-filter') as HTMLSelectElement | null;
    const methodSelect = document.getElementById('order-method-filter') as HTMLSelectElement | null;

    function render() {
      if (!tbody) return;

      const rows = table.getPaginatedRowModel().rows;
      const totalFiltered = table.getFilteredRowModel().rows.length;

      if (countBadge) {
        countBadge.textContent = String(totalFiltered);
      }

      if (rows.length === 0) {
        tbody.innerHTML = '';
        emptyState?.classList.remove('hidden');
      } else {
        emptyState?.classList.add('hidden');
        tbody.innerHTML = rows
          .map((row: any) => {
            const o = row.original;
            const statusBadge =
              o.status === 'paid'
                ? `<span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-50 px-2.5 py-0.5 text-xs font-medium text-emerald-700 ring-1 ring-inset ring-emerald-600/20"><span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span> Paid</span>`
                : o.status === 'refunded'
                ? `<span class="inline-flex items-center gap-1.5 rounded-full bg-amber-50 px-2.5 py-0.5 text-xs font-medium text-amber-700 ring-1 ring-inset ring-amber-600/20"><span class="h-1.5 w-1.5 rounded-full bg-amber-500"></span> Refunded</span>`
                : `<span class="inline-flex items-center gap-1.5 rounded-full bg-gray-100 px-2.5 py-0.5 text-xs font-medium text-gray-600 ring-1 ring-inset ring-gray-500/20"><span class="h-1.5 w-1.5 rounded-full bg-gray-400"></span> ${o.status}</span>`;

            const fulfillmentBadge =
              o.fulfillment_status === 'fulfilled'
                ? `<span class="inline-flex items-center gap-1.5 rounded-full bg-blue-50 px-2.5 py-0.5 text-xs font-medium text-blue-700 ring-1 ring-inset ring-blue-600/20"><span class="h-1.5 w-1.5 rounded-full bg-blue-500"></span> Fulfilled</span>`
                : `<span class="inline-flex items-center gap-1.5 rounded-full bg-gray-100 px-2.5 py-0.5 text-xs font-medium text-gray-500 ring-1 ring-inset ring-gray-400/20">Unfulfilled</span>`;

            const emailCell = o.email
              ? `<a href="/admin/customers/${o.encodedEmail}" title="${o.email}" class="text-ink hover:text-brand font-medium block truncate">${o.email}</a>`
              : `<span class="text-gray-400">—</span>`;

            return `
              <tr class="hover:bg-paper/40 transition-colors group">
                <td class="py-3 px-4 tabular-nums">
                  <a href="/admin/orders/${o.public_id}" class="font-semibold text-accent hover:underline">#${o.id}</a>
                </td>
                <td class="py-3 px-3 font-mono text-xs">
                  <a href="/admin/orders/${o.public_id}" title="${o.public_id || ''}" class="text-accent hover:underline block truncate">${o.shortPublicId}</a>
                </td>
                <td class="py-3 px-3 max-w-0">${emailCell}</td>
                <td class="py-3 px-3 font-medium text-ink tabular-nums whitespace-nowrap">${o.formattedTotal}</td>
                <td class="py-3 px-3 text-center whitespace-nowrap">${statusBadge}</td>
                <td class="py-3 px-3 text-center whitespace-nowrap">${fulfillmentBadge}</td>
                <td class="py-3 px-4 text-right text-muted whitespace-nowrap text-xs">${o.formattedDate}</td>
              </tr>
            `;
          })
          .join('');
      }

      // Update header sort icons
      document.querySelectorAll<HTMLElement>('#admin-tanstack-order-table th[data-sort]').forEach((th) => {
        const sortKey = th.getAttribute('data-sort');
        const icon = th.querySelector('.sort-icon');
        const currentSort = sorting.find((s) => s.id === sortKey);
        if (icon) {
          if (!currentSort) {
            icon.textContent = '↕';
            icon.className = 'sort-icon text-gray-300 text-2xs';
          } else if (currentSort.desc) {
            icon.textContent = '↓';
            icon.className = 'sort-icon text-brand font-bold text-2xs';
          } else {
            icon.textContent = '↑';
            icon.className = 'sort-icon text-brand font-bold text-2xs';
          }
        }
      });

      // Update pagination UI
      const pageIndex = (table as any).atoms?.pagination?.get()?.pageIndex ?? 0;
      const pageCount = table.getPageCount() || 1;
      if (pageInfoLabel) {
        pageInfoLabel.textContent = `Page ${pageIndex + 1} of ${pageCount}`;
      }
      if (btnPrev) btnPrev.disabled = !table.getCanPreviousPage();
      if (btnNext) btnNext.disabled = !table.getCanNextPage();
    }

    // Subscribe to store updates
    (table as any).store?.subscribe(() => {
      render();
    });

    // Attach Header Sort Handlers
    document.querySelectorAll<HTMLElement>('#admin-tanstack-order-table th[data-sort]').forEach((th) => {
      th.addEventListener('click', () => {
        const colId = th.getAttribute('data-sort');
        if (!colId) return;

        const currentSort = sorting.find((s) => s.id === colId);
        if (!currentSort) {
          sorting = [{ id: colId, desc: false }];
        } else if (!currentSort.desc) {
          sorting = [{ id: colId, desc: true }];
        } else {
          sorting = [];
        }

        table.setSorting(sorting);
      });
    });

    // Attach Search Handler with Debounce
    let debounceTimer: ReturnType<typeof setTimeout>;
    searchInput?.addEventListener('input', (e) => {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(() => {
        const val = (e.target as HTMLInputElement).value;
        table.setGlobalFilter(val);
      }, 150);
    });

    // Attach Filter Select Handlers
    function applyCustomFilters() {
      const statusVal = statusSelect?.value || 'all';
      const fulfillmentVal = fulfillmentSelect?.value || 'all';
      const methodVal = methodSelect?.value || 'all';

      const nextFilters: ColumnFiltersState = [];

      if (statusVal !== 'all') {
        nextFilters.push({ id: 'status', value: statusVal });
      }
      if (fulfillmentVal !== 'all') {
        nextFilters.push({ id: 'fulfillment_status', value: fulfillmentVal });
      }
      if (methodVal !== 'all') {
        nextFilters.push({ id: 'payment_method', value: methodVal });
      }

      table.setColumnFilters(nextFilters);
    }

    statusSelect?.addEventListener('change', applyCustomFilters);
    fulfillmentSelect?.addEventListener('change', applyCustomFilters);
    methodSelect?.addEventListener('change', applyCustomFilters);

    // Attach Pagination Handlers
    btnPrev?.addEventListener('click', () => table.previousPage());
    btnNext?.addEventListener('click', () => table.nextPage());
    pageSizeSelect?.addEventListener('change', (e) => {
      const newSize = Number((e.target as HTMLSelectElement).value);
      table.setPageSize(newSize);
    });

    // Initial render
    render();
  }
</script>
