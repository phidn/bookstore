---
/**
 * The header cart link and its live count badge.
 *
 * Owns two hooks the document shell's enhancement script depends on:
 * `data-cart-open` (intercepted to open the drawer instead of navigating) and
 * `data-cart-count-label` (where the badge text is written). The script fails
 * soft when they are missing, so losing them breaks the drawer silently —
 * which is why they live here and not in an editable file.
 *
 * The drawer markup itself stays in the document shell, beside that script.
 */
interface Props {
  href: string;
  class?: string;
  label?: string;
  showIcon?: boolean;
  countClass?: string;
}

const {
  href,
  class: className = 'inline-flex items-center hover:text-brand',
  label = 'Cart',
  showIcon = false,
  countClass = 'inline-block min-w-[4ch] tabular-nums',
} = Astro.props;
---

<a href={href} data-cart-open class={className}>
  {
    showIcon && (
      <svg aria-hidden="true" viewBox="0 0 24 24" class="h-6 w-6 shrink-0" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 8h14l-1 12H6L5 8Z" />
        <path d="M9 9V6a3 3 0 0 1 6 0v3" />
      </svg>
    )
  }
  <span>
    {label}
    <span
      data-cart-count-label
      class={countClass}
      aria-live="polite"
      aria-atomic="true"
    />
  </span>
</a>
