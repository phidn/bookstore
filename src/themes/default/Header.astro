---
import type { StorefrontShellModel } from '../../features/storefront/models';
import StoreNav from '../../features/storefront/controls/StoreNav.astro';
import StoreSearch from '../../features/storefront/controls/StoreSearch.astro';
import StoreCartControl from '../../features/storefront/controls/StoreCartControl.astro';
import StoreAccountControl from '../../features/storefront/controls/StoreAccountControl.astro';

/** Full-width bookstore masthead. Core search/cart/account controls stay intact;
 *  this theme only changes their placement and visual treatment. */
interface Props {
  model: StorefrontShellModel;
}

const { model } = Astro.props;
---

{
  model.announcement && (
    <div class="bg-brand text-on-brand">
      <div class="mx-auto max-w-[96rem] px-5 py-2 text-center text-xs tracking-wide sm:px-8">
        {model.announcement.href ? (
          <a href={model.announcement.href} class="underline-offset-2 hover:underline">
            {model.announcement.text}
          </a>
        ) : (
          model.announcement.text
        )}
      </div>
    </div>
  )
}

<header class="sticky top-0 z-30 bg-paper/95 backdrop-blur">
  <div class="mx-auto max-w-[96rem] px-5 sm:px-8">
    <div class="flex min-h-20 flex-wrap items-center gap-x-5 gap-y-3 py-3 lg:flex-nowrap">
      <a
        href="/"
        aria-label={model.storeName}
        class="flex shrink-0 items-center gap-3 whitespace-nowrap font-serif text-lg tracking-[-0.025em] text-ink sm:text-[1.35rem]"
      >
        {
          model.logo ? (
            <img src={model.logo.src} alt={model.logo.alt} class="h-10 w-10 shrink-0 object-contain" />
          ) : (
            <img src="/brand/logo-mark-dark.svg" alt="" aria-hidden="true" class="h-10 w-10 shrink-0 object-contain" />
          )
        }
        <span>{model.storeName}</span>
      </a>

      <StoreSearch
        action={model.search.action}
        query={model.search.query}
        class="order-3 flex w-full min-w-0 flex-1 items-center rounded-lg border-2 border-brand bg-surface p-1 focus-within:ring-2 focus-within:ring-brand/15 lg:order-none lg:ml-8"
        inputClass="w-full min-w-0 bg-transparent px-3 py-2.5 text-sm text-ink placeholder:text-faint focus:outline-none"
        placeholder="Tìm theo tên sách, tác giả hoặc ISBN"
        showIcon
        submitLabel="Tìm kiếm"
        buttonClass="shrink-0 rounded-md bg-brand px-6 py-2.5 text-xs font-semibold text-on-brand transition-colors hover:bg-brand-hover"
      />

      <nav aria-label="Tiện ích cửa hàng" class="ml-auto flex shrink-0 items-center gap-4 text-[0.66rem] uppercase tracking-[0.14em] text-muted sm:gap-5">
        <a href={model.search.action} class="hidden flex-col items-center gap-1 hover:text-brand sm:flex lg:hidden">
          <svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4 4"/></svg>
          Tìm kiếm
        </a>
        {model.account.enabled && (
          <StoreAccountControl
            href={model.account.href}
            class="hidden items-center gap-1 hover:text-brand sm:inline-flex"
          />
        )}
        {model.cart.enabled && (
          <StoreCartControl
            href={model.cart.href}
            label="Giỏ sách"
            showIcon
            countClass="ml-0.5 tabular-nums"
            class="inline-flex min-h-12 items-center gap-2 rounded-lg px-3 font-semibold text-brand transition-colors hover:bg-brand/10"
          />
        )}
      </nav>
    </div>

    <div class="flex min-h-12 items-center justify-center">
      <nav aria-label="Danh mục chính" class="flex min-w-0 items-center justify-center gap-7 text-xs font-semibold uppercase tracking-[0.14em] text-muted">
        <a href="/#selected-books" class="hidden shrink-0 hover:text-brand sm:block">Sách tuyển chọn</a>
        <a href="/products" class="shrink-0 text-brand hover:text-brand-hover">Tất cả sách</a>
        <StoreNav
          links={model.headerLinks}
          class="hidden min-w-0 items-center gap-6 md:flex"
          disclosureClass="relative order-last md:hidden"
        />
      </nav>
    </div>
  </div>
</header>
