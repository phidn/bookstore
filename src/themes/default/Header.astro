---
import type { StorefrontShellModel } from '../../features/storefront/models';
import StoreNav from '../../features/storefront/controls/StoreNav.astro';
import StoreSearch from '../../features/storefront/controls/StoreSearch.astro';
import StoreCartControl from '../../features/storefront/controls/StoreCartControl.astro';
import StoreAccountControl from '../../features/storefront/controls/StoreAccountControl.astro';

/**
 * STORE-OWNED. Edit freely — this file belongs to your store.
 *
 * It renders on EVERY page, including cart, checkout, payment, account, and
 * Admin login. A broken header is a broken checkout, so keep the core controls
 * below and change their placement and styling rather than their markup.
 *
 * See docs/CUSTOMIZING.md for the full contract.
 */
interface Props {
  model: StorefrontShellModel;
}

const { model } = Astro.props;
---

{/* Announcement bar. Deliberately NOT fixed: the header below is sticky, so a
    fixed bar would need the header offset by the bar's height — which varies
    as the message wraps on narrow screens. Static means it's seen on load,
    scrolls away, and costs no vertical space on mobile. */}
{
  model.announcement && (
    <div class="bg-brand text-on-brand">
      <div class="mx-auto max-w-6xl px-6 py-2 text-center text-xs tracking-wide">
        {model.announcement.href ? (
          <a href={model.announcement.href} class="underline-offset-2 hover:underline">
            {model.announcement.text}
          </a>
        ) : (
          model.announcement.text
        )}
      </div>
    </div>
  )
}

<header class="sticky top-0 z-20 border-b border-line bg-paper/85 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center gap-4 px-6 py-4 sm:gap-6 sm:py-5">
    <a
      href="/"
      aria-label={model.storeName}
      class="flex shrink-0 items-center gap-2.5 whitespace-nowrap font-serif text-base tracking-tight sm:text-2xl"
    >
      {model.logo && (
        /* Keep the complete brand name visible beside the mark. The source
           avatar has generous ivory breathing room, so the slight scale-up
           lets its pavilion/book symbol read clearly at header size. */
        <span class="h-9 w-9 shrink-0 overflow-hidden rounded-full sm:h-10 sm:w-10">
          <img
            src={model.logo.src}
            alt={model.storeName}
            class="h-full w-full scale-[1.38] object-cover"
          />
        </span>
      )}
      <span>{model.storeName}</span>
    </a>
    <StoreSearch
      action={model.search.action}
      query={model.search.query}
      class="ml-auto hidden flex-1 justify-end sm:flex"
    />
    {/* ml-auto pins the whole nav to the right edge of the header row, so it
        stays flush right no matter how few items a merchant has.
        min-w-0 is what lets long labels ellipsize instead of overflowing the
        page: flex items default to min-width:auto, and without it here the
        shrink stops at this level and the row grows past the viewport —
        putting min-w-0 only on the links themselves is not enough. */}
    <nav
      aria-label="Primary"
      class="ml-auto flex min-w-0 items-center gap-4 text-xs uppercase tracking-widest text-muted sm:gap-6"
    >
      <StoreNav links={model.headerLinks} />
      {/* Search input is desktop-only; give mobile a link to the search page. */}
      <a href={model.search.action} class="hover:text-brand sm:hidden">Search</a>
      {model.cart.enabled && <StoreCartControl href={model.cart.href} />}
      {model.account.enabled && <StoreAccountControl href={model.account.href} />}
    </nav>
  </div>
</header>
