---
import type { ProductCardModel } from '../../features/storefront/models';
import StoreImage from '../../features/storefront/controls/StoreImage.astro';

interface Props {
  featuredBooks: ProductCardModel[];
  storeName?: string;
}

const { featuredBooks, storeName = 'Tiểu Viện Hữu Thư' } = Astro.props;
const showcaseBooks = featuredBooks.slice(0, 4);
---

<div class="homepage-bleed">
<section aria-label="Giới thiệu nổi bật" class="mx-auto mt-5 max-w-[96rem] px-5 sm:px-8">
  <div data-home-slider>
  <div data-slider-viewport class="no-scrollbar flex snap-x snap-mandatory overflow-x-auto rounded-2xl bg-surface shadow-sm ring-1 ring-line">
    <article data-slide class="relative grid min-w-full snap-start overflow-hidden bg-[#e8d4c4] lg:grid-cols-[1.05fr_.95fr]">
      <div class="relative z-10 flex min-h-[27rem] flex-col justify-center px-7 py-14 sm:px-12 lg:px-16">
        <p class="text-xs font-semibold uppercase tracking-[0.28em] text-brand">Sách cũ được tuyển chọn</p>
        <h1 class="mt-5 max-w-2xl font-serif text-4xl leading-[1.12] tracking-[-0.035em] text-ink sm:text-5xl lg:text-6xl">
          Một cuốn sách cũ.<br />Một câu chuyện mới.
        </h1>
        <p class="mt-6 max-w-lg text-sm leading-7 text-muted sm:text-base">
          Ghé {storeName} và tìm cuốn sách tiếp theo sẽ ở lại thật lâu trên kệ của bạn.
        </p>
        <a href="/products" class="mt-8 inline-flex w-fit items-center rounded-full bg-brand px-7 py-3 text-sm font-semibold text-on-brand transition-colors hover:bg-brand-hover">
          Khám phá sách
        </a>
      </div>
      <div class="relative hidden min-h-[27rem] items-center justify-center overflow-hidden bg-[#d8bca7] lg:flex">
        <div class="absolute -right-16 -top-20 h-72 w-72 rounded-full bg-[#b8836d]/45"></div>
        <div class="absolute -bottom-28 left-10 h-72 w-72 rounded-full bg-[#f4eadf]/70"></div>
        {
          showcaseBooks.length > 0 ? (
            <div class="relative flex items-end gap-4 px-12">
              {showcaseBooks.map((book, index) => (
                <a href={book.href} class={`block w-28 overflow-hidden rounded-sm shadow-xl transition-transform hover:-translate-y-2 ${index % 2 ? '-rotate-2 translate-y-5' : 'rotate-2'}`}>
                  <StoreImage image={book.image} class="aspect-[2/3] w-full object-cover" />
                </a>
              ))}
            </div>
          ) : (
            <svg aria-hidden="true" viewBox="0 0 520 330" class="relative w-[78%] text-brand-hover">
              <path d="M62 266h396M110 266V83h79v183m18 0V45h92v221m18 0V105h94v161" fill="none" stroke="currentColor" stroke-width="8" stroke-linecap="round"/>
              <path d="M125 109h49m-49 25h49m49-57h60m-60 28h60m49 35h63m-63 27h63" stroke="currentColor" stroke-width="5" opacity=".55"/>
            </svg>
          )
        }
      </div>
      <button type="button" data-slide-target="2" aria-label="Slide trước" class="absolute left-4 top-1/2 z-20 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full bg-white/85 text-xl text-ink shadow-sm">‹</button>
      <button type="button" data-slide-target="1" aria-label="Slide sau" class="absolute right-4 top-1/2 z-20 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full bg-white/85 text-xl text-ink shadow-sm">›</button>
    </article>

    <article data-slide class="relative grid min-w-full snap-start overflow-hidden bg-brand text-on-brand lg:grid-cols-2">
      <div class="flex min-h-[27rem] flex-col justify-center px-7 py-14 sm:px-12 lg:px-16">
        <p class="text-xs font-semibold uppercase tracking-[0.28em] text-white/65">Những cuộc trò chuyện về sách</p>
        <h2 class="mt-5 max-w-xl font-serif text-4xl leading-tight tracking-[-0.03em] sm:text-5xl">Đọc xong rồi, mình nói với nhau nghe.</h2>
        <p class="mt-6 max-w-lg text-sm leading-7 text-white/75 sm:text-base">Ở tiểu viện, sách không kết thúc ở trang cuối. Mỗi cuốn là một lời mời để nhớ, nghĩ và kể tiếp.</p>
        <a href="/products" class="mt-8 inline-flex w-fit items-center rounded-full bg-paper px-7 py-3 text-sm font-semibold text-brand hover:bg-white">Chọn một câu chuyện</a>
      </div>
      <div class="relative hidden items-center justify-center lg:flex">
        <svg aria-hidden="true" viewBox="0 0 520 330" class="w-[78%] text-white/80" fill="none" stroke="currentColor">
          <path d="M84 89c65-20 123-8 176 36v145c-53-44-111-56-176-36V89Zm352 0c-65-20-123-8-176 36v145c53-44 111-56 176-36V89Z" stroke-width="7" stroke-linejoin="round"/>
          <path d="M115 125c38-8 74-1 108 20m-108 25c38-8 74-1 108 20m182-65c-38-8-74-1-108 20m108 25c-38-8-74-1-108 20" stroke-width="4" stroke-linecap="round" opacity=".55"/>
        </svg>
      </div>
      <button type="button" data-slide-target="0" aria-label="Slide trước" class="absolute left-4 top-1/2 z-20 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full bg-white/90 text-xl text-brand shadow-sm">‹</button>
      <button type="button" data-slide-target="2" aria-label="Slide sau" class="absolute right-4 top-1/2 z-20 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full bg-white/90 text-xl text-brand shadow-sm">›</button>
    </article>

    <article data-slide class="relative grid min-w-full snap-start overflow-hidden bg-[#efe8dc] lg:grid-cols-[1.1fr_.9fr]">
      <div class="flex min-h-[27rem] flex-col justify-center px-7 py-14 sm:px-12 lg:px-16">
        <p class="text-xs font-semibold uppercase tracking-[0.28em] text-brand">Gửi sách từ TP. Hồ Chí Minh</p>
        <h2 class="mt-5 max-w-2xl font-serif text-4xl leading-tight tracking-[-0.03em] text-ink sm:text-5xl">Bọc một cuốn sách bằng thật nhiều cẩn thận.</h2>
        <p class="mt-6 max-w-lg text-sm leading-7 text-muted sm:text-base">Tình trạng sách được mô tả rõ ràng, đóng gói kỹ và giao đến bạn trên toàn quốc.</p>
        <a href="/products" class="mt-8 inline-flex w-fit items-center rounded-full border border-brand px-7 py-3 text-sm font-semibold text-brand hover:bg-brand hover:text-on-brand">Xem sách đang có</a>
      </div>
      <div class="relative hidden items-center justify-center lg:flex">
        <svg aria-hidden="true" viewBox="0 0 450 330" class="w-[76%] text-brand" fill="none" stroke="currentColor" stroke-linejoin="round">
          <path d="m79 126 146-72 146 72-146 73-146-73Zm0 0v106l146 53 146-53V126M225 199v86" stroke-width="7"/>
          <path d="m146 93 147 71v57" stroke-width="5" opacity=".5"/>
          <path d="M196 105c19-19 39-18 58 0-19 25-39 25-58 0Z" fill="currentColor" stroke="none" opacity=".28"/>
        </svg>
      </div>
      <button type="button" data-slide-target="1" aria-label="Slide trước" class="absolute left-4 top-1/2 z-20 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full bg-white/90 text-xl text-ink shadow-sm">‹</button>
      <button type="button" data-slide-target="0" aria-label="Slide sau" class="absolute right-4 top-1/2 z-20 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full bg-white/90 text-xl text-ink shadow-sm">›</button>
    </article>
  </div>
  <nav aria-label="Chọn slide" class="mt-4 flex justify-center gap-2">
    <button type="button" data-slide-dot data-slide-target="0" data-active aria-label="Đến slide 1"></button>
    <button type="button" data-slide-dot data-slide-target="1" aria-label="Đến slide 2"></button>
    <button type="button" data-slide-dot data-slide-target="2" aria-label="Đến slide 3"></button>
  </nav>
  </div>
</section>

<section aria-label="Cam kết của tiểu viện" class="mx-auto mt-10 max-w-[96rem] px-5 sm:px-8">
  <div class="grid divide-y divide-line border-y border-line sm:grid-cols-3 sm:divide-x sm:divide-y-0">
    <div class="flex items-center justify-center gap-3 px-5 py-5 text-center"><span aria-hidden="true" class="text-xl">☕</span><p class="text-xs font-medium uppercase tracking-[0.15em] text-muted">Sách cũ được tuyển chọn</p></div>
    <div class="flex items-center justify-center gap-3 px-5 py-5 text-center"><span aria-hidden="true" class="text-xl">⌁</span><p class="text-xs font-medium uppercase tracking-[0.15em] text-muted">Mô tả tình trạng rõ ràng</p></div>
    <div class="flex items-center justify-center gap-3 px-5 py-5 text-center"><span aria-hidden="true" class="text-xl">✦</span><p class="text-xs font-medium uppercase tracking-[0.15em] text-muted">Gói kỹ · giao toàn quốc</p></div>
  </div>
</section>

<section aria-labelledby="selected-books" class="mx-auto mt-20 max-w-[96rem] px-5 sm:px-8">
  <div class="mb-7 flex items-end justify-between gap-5 border-b border-line pb-4">
    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.26em] text-brand">Trên kệ tiểu viện</p>
      <h2 id="selected-books" class="mt-2 font-serif text-3xl tracking-[-0.025em] text-ink sm:text-4xl">Sách tuyển chọn</h2>
    </div>
    <a href="/products" class="shrink-0 text-sm text-muted underline decoration-gray-300 underline-offset-4 hover:text-brand">Xem tất cả</a>
  </div>

  {
    featuredBooks.length > 0 ? (
      <ul class="no-scrollbar -mx-5 flex snap-x gap-4 overflow-x-auto px-5 pb-4 sm:mx-0 sm:grid sm:grid-cols-3 sm:overflow-visible sm:px-0 lg:grid-cols-6">
        {featuredBooks.map((book, index) => (
          <li class="reveal group flex w-[68vw] max-w-[17rem] shrink-0 snap-start flex-col sm:w-auto" style={`animation-delay:${Math.min(index, 6) * 60}ms`}>
            <a href={book.href} class="block">
              <div class="relative overflow-hidden rounded-lg bg-surface ring-1 ring-line">
                <StoreImage image={book.image} fade class={`aspect-[2/3] w-full object-cover transition-transform duration-500 group-hover:scale-[1.035]${book.inStock ? '' : ' opacity-60'}`} />
                {!book.inStock && <span class="absolute left-3 top-3 rounded-full bg-paper/90 px-2 py-1 text-[10px] uppercase tracking-wider text-muted">Hết hàng</span>}
              </div>
              <h3 class="mt-4 line-clamp-2 min-h-10 text-sm font-medium leading-5 text-ink">{book.name}</h3>
              <p class="mt-2 font-serif text-base font-semibold tabular-nums text-brand">{book.formattedPrice}</p>
            </a>
            <a href={book.href} class="mt-4 inline-flex w-full items-center justify-center rounded-full border border-brand px-4 py-2.5 text-xs font-semibold uppercase tracking-[0.1em] text-brand transition-colors hover:bg-brand hover:text-on-brand">Xem cuốn sách</a>
          </li>
        ))}
      </ul>
    ) : (
      <div class="rounded-2xl border border-dashed border-line bg-surface px-6 py-14 text-center">
        <p class="font-serif text-2xl text-ink">Kệ sách đang được sắp xếp.</p>
        <p class="mt-2 text-sm text-muted">Những cuốn sách tuyển chọn sẽ sớm xuất hiện tại đây.</p>
      </div>
    )
  }
</section>

<section class="mx-auto mt-20 max-w-[96rem] px-5 sm:px-8">
  <div class="grid overflow-hidden rounded-2xl bg-[#e9dfd2] lg:grid-cols-2">
    <div class="flex flex-col justify-center px-7 py-12 sm:px-12 lg:px-16">
      <p class="text-xs font-semibold uppercase tracking-[0.26em] text-brand">Có một cuốn sách cũ?</p>
      <h2 class="mt-4 font-serif text-3xl leading-tight tracking-[-0.025em] text-ink sm:text-4xl">Để cuốn sách ấy gặp người đọc tiếp theo.</h2>
      <p class="mt-5 max-w-lg text-sm leading-7 text-muted">Tiểu Viện Hữu Thư tin rằng sách cũ không cũ đi — chúng chỉ đang chờ một cuộc trò chuyện mới.</p>
    </div>
    <div class="flex min-h-72 items-center justify-center bg-brand px-8 py-12 text-on-brand">
      <div class="text-center">
        <svg aria-hidden="true" viewBox="0 0 180 120" class="mx-auto h-28 w-44" fill="none" stroke="currentColor" stroke-width="3">
          <path d="M24 31c25-8 47-3 66 14v59c-19-17-41-22-66-14V31Zm132 0c-25-8-47-3-66 14v59c19-17 41-22 66-14V31Z" stroke-linejoin="round"/><path d="M41 50c15-3 28 0 39 8m-39 14c15-3 28 0 39 8m59-30c-15-3-28 0-39 8m39 14c-15-3-28 0-39 8" opacity=".5"/>
        </svg>
        <p class="mt-3 font-serif text-2xl">Tiểu viện có bán sách cũ.</p>
      </div>
    </div>
  </div>
</section>
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-home-slider]')) {
    const viewport = root.querySelector<HTMLElement>('[data-slider-viewport]');
    const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-slide]'));
    const dots = Array.from(root.querySelectorAll<HTMLElement>('[data-slide-dot]'));
    if (!viewport || slides.length === 0) continue;

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const setActive = (index: number) => {
      dots.forEach((dot, dotIndex) => {
        if (dotIndex === index) dot.setAttribute('data-active', '');
        else dot.removeAttribute('data-active');
      });
    };
    const goTo = (index: number) => {
      const slide = slides[index];
      if (!slide) return;
      const left = viewport.scrollLeft + slide.getBoundingClientRect().left - viewport.getBoundingClientRect().left;
      viewport.scrollTo({ left, behavior: reducedMotion.matches ? 'auto' : 'smooth' });
      setActive(index);
    };

    root.querySelectorAll<HTMLElement>('[data-slide-target]').forEach((control) => {
      control.addEventListener('click', () => goTo(Number(control.dataset.slideTarget)));
    });

    let frame = 0;
    viewport.addEventListener('scroll', () => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => {
        const index = Math.max(0, Math.min(slides.length - 1, Math.round(viewport.scrollLeft / viewport.clientWidth)));
        setActive(index);
      });
    }, { passive: true });
  }
</script>

<style>
  /* Layout keeps one canonical page-shell for every storefront route. The
     landing page opts into a viewport-wide canvas from inside that contract. */
  .homepage-bleed {
    width: 100vw;
    margin-block: -3rem;
    margin-left: calc(50% - 50vw);
    padding-block: 3rem 0;
    overflow: clip;
  }

  [data-slide-dot] {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 9999px;
    background: var(--color-line);
    transition: width 180ms ease, background-color 180ms ease;
  }

  [data-slide-dot][data-active] {
    width: 2rem;
    background: var(--color-brand);
  }

  [data-slide-dot]:focus-visible {
    outline: 2px solid var(--color-brand);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-slide-dot] {
      transition: none;
    }
  }
</style>
