---
import type { StorefrontShellModel } from '../../features/storefront/models';

interface Props {
  model: StorefrontShellModel;
}

const { model } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="mt-20 bg-brand-hover text-on-brand">
  <div class="mx-auto max-w-[96rem] px-5 sm:px-8">
    <div class="flex justify-center border-b border-white/15 py-7">
      <a href="/" class="flex flex-col items-center gap-2 font-serif text-lg" aria-label={model.storeName}>
        <img src="/brand/logo-mark-light.svg" alt="" aria-hidden="true" class="h-11 w-11" />
        <span>{model.storeName}</span>
      </a>
    </div>

    <div class="grid gap-10 py-12 sm:grid-cols-2 lg:grid-cols-[1.5fr_1fr_1fr_1fr] lg:gap-14">
      <div>
        <h2 class="font-serif text-xl leading-snug">Sách cũ, những cuộc trò chuyện mới.</h2>
        <p class="mt-4 max-w-sm text-sm leading-6 text-white/70">
          Một tiểu viện nhỏ có nhiều chuyện để nói với nhau nghe. Chúng tôi tuyển chọn và gửi đi những cuốn sách đã được yêu thương.
        </p>
        <a href="https://tieuvienhuuthu.store" class="mt-5 inline-block text-sm underline decoration-white/30 underline-offset-4 hover:decoration-white">
          tieuvienhuuthu.store
        </a>
        <div class="mt-6">
          <p class="text-xs uppercase tracking-[0.16em] text-white/50">@tieuvienhuuthu</p>
          <div role="group" aria-label="Mạng xã hội của Tiểu Viện Hữu Thư" class="mt-3 flex items-center gap-2.5">
            <a href="https://www.facebook.com/tieuvienhuuthu" target="_blank" rel="noopener noreferrer" aria-label="Facebook — @tieuvienhuuthu" class="flex h-10 w-10 items-center justify-center rounded-full border border-white/25 text-white/75 transition-colors hover:border-white hover:bg-white hover:text-brand-hover">
              <svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor"><path d="M13.7 21v-8h2.7l.4-3h-3.1V8.1c0-.9.3-1.5 1.6-1.5H17V3.9c-.3 0-1.3-.1-2.5-.1-2.5 0-4.2 1.5-4.2 4.3V10H7.5v3h2.8v8h3.4Z"/></svg>
            </a>
            <a href="https://www.instagram.com/tieuvienhuuthu" target="_blank" rel="noopener noreferrer" aria-label="Instagram — @tieuvienhuuthu" class="flex h-10 w-10 items-center justify-center rounded-full border border-white/25 text-white/75 transition-colors hover:border-white hover:bg-white hover:text-brand-hover">
              <svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.6" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
            </a>
            <a href="https://www.tiktok.com/@tieuvienhuuthu" target="_blank" rel="noopener noreferrer" aria-label="TikTok — @tieuvienhuuthu" class="flex h-10 w-10 items-center justify-center rounded-full border border-white/25 text-white/75 transition-colors hover:border-white hover:bg-white hover:text-brand-hover">
              <svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor"><path d="M15.3 3c.3 2.2 1.6 3.6 3.7 3.8v3.1a7.5 7.5 0 0 1-3.7-1.1v6.1a6 6 0 1 1-5.2-5.9v3.2a2.9 2.9 0 1 0 2 2.7V3h3.2Z"/></svg>
            </a>
            <a href="https://www.threads.net/@tieuvienhuuthu" target="_blank" rel="noopener noreferrer" aria-label="Threads — @tieuvienhuuthu" class="flex h-10 w-10 items-center justify-center rounded-full border border-white/25 text-white/75 transition-colors hover:border-white hover:bg-white hover:text-brand-hover">
              <svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M17.6 10.2c-.4-4.1-2.6-6.3-5.8-6.3-3.8 0-6.3 2.9-6.3 8.1s2.6 8.1 6.6 8.1c3.5 0 6-2 6-5 0-2.7-2-4.4-5-4.4-2.7 0-4.4 1.3-4.4 3.3 0 1.7 1.4 2.8 3.2 2.8 2.8 0 4.7-2.4 4.7-5.6 0-2.5-1.4-4.2-4-4.2-1.4 0-2.7.5-3.5 1.4"/></svg>
            </a>
          </div>
        </div>
      </div>

      <div>
        <h2 class="font-serif text-base">Khám phá</h2>
        <div class="mt-4 flex flex-col items-start gap-3 text-sm text-white/70">
          <a href="/products" class="hover:text-white">Tất cả sách</a>
          <a href="/search" class="hover:text-white">Tìm kiếm</a>
          {model.cart.enabled && <a href={model.cart.href} class="hover:text-white">Giỏ sách</a>}
        </div>
      </div>

      <div>
        <h2 class="font-serif text-base">Tiểu viện</h2>
        {
          model.footerLinks.length > 0 ? (
            <nav aria-label="Tiểu viện" class="mt-4 flex flex-col items-start gap-3 text-sm text-white/70">
              {model.footerLinks.map((link) => <a href={link.href} class="hover:text-white">{link.text}</a>)}
            </nav>
          ) : (
            <p class="mt-4 text-sm leading-6 text-white/70">TP. Hồ Chí Minh<br />Giao sách toàn quốc</p>
          )
        }
      </div>

      <div>
        <h2 class="font-serif text-base">Cam kết</h2>
        <ul class="mt-4 space-y-3 text-sm leading-5 text-white/70">
          <li>Sách được kiểm tra kỹ</li>
          <li>Mô tả tình trạng rõ ràng</li>
          <li>Đóng gói cẩn thận</li>
        </ul>
      </div>
    </div>

    <div class="flex flex-wrap items-center justify-between gap-3 border-t border-white/15 py-5 text-xs text-white/55">
      <span>&copy; {year} {model.storeName}</span>
      <span>Tiểu viện có bán sách cũ.</span>
    </div>
  </div>
</footer>
